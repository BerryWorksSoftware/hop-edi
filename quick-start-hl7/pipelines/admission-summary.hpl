<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>HL7 admission procedures and insurance</name>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
      <parameter>
        <name>HL7_QUICK_START_HOME</name>
        <default_value>${PROJECT_HOME}</default_value>
        <description>Absolute path to the quick-start-hl7 folder</description>
      </parameter>
    </parameters>
  </info>
  <notepads>
    <notepad>
      <note>ADT A01: one fictional admission, two procedures, two insurers.
Set HL7_QUICK_START_HOME to this demo folder.
The raw CSV shows loop boundaries; the summary CSV contains four business rows.</note>
      <xloc>80</xloc>
      <yloc>30</yloc>
      <width>770</width>
      <heigth>95</heigth>
      <fontname>Arial</fontname>
      <fontsize>11</fontsize>
      <backgroundcolorred>255</backgroundcolorred>
      <backgroundcolorgreen>255</backgroundcolorgreen>
      <backgroundcolorblue>210</backgroundcolorblue>
    </notepad>
  </notepads>
  <transform>
    <name>Read HL7 admission</name>
    <type>BerryWorksEdiInput</type>
    <copies>1</copies>
    <distribute>N</distribute>
    <GUI>
      <xloc>100</xloc>
      <yloc>220</yloc>
    </GUI>
    <filename>${HL7_QUICK_START_HOME}/input/admission.hl7</filename>
    <modelsDirectory>${HL7_QUICK_START_HOME}/edi-models</modelsDirectory>
  </transform>
  <transform>
    <name>Extract procedures and insurance</name>
    <type>ScriptValueMod</type>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>380</xloc>
      <yloc>300</yloc>
    </GUI>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Extract ADT business rows</jsScript_name>
        <jsScript_script>// This small mapping is specific to the supplied ADT A01 example.
var pipeline_Status = SKIP_PIPELINE;
function text(value) { return value == null ? "" : String(value); }
if (row_type == "ENVELOPE" &amp;&amp; segment_id == "MSH") {
  patient_id=""; patient_name=""; pid_sequence=-1; name_sequence=-1;
}
if (row_type == "SEGMENT" &amp;&amp; segment_id == "PID") { pid_sequence=Number(sequence_number); }
if (row_type == "COMPOSITE" &amp;&amp; segment_id == "PID" &amp;&amp; Number(parent_sequence_number)==pid_sequence) {
  if (Number(element_position)==3) { patient_id=text(element_01); }
  if (Number(element_position)==5) {
    name_sequence=Number(sequence_number);
    patient_name=text(element_02)+" "+text(element_01);
  }
}
// FN family names may themselves be emitted as a nested composite.
if (row_type == "COMPOSITE" &amp;&amp; segment_id == "PID" &amp;&amp; Number(parent_sequence_number)==name_sequence &amp;&amp; Number(element_position)==1) {
  patient_name=patient_name.replace(/&lt;COMPOSITE&gt;$/, text(element_01));
}
if (row_type == "LOOP_START") {
  if (loop_id == "PR1-ADT_A01-PROCEDURE") { group_type="Procedure"; }
  else if (loop_id == "IN1-ADT_A01-INSURANCE") { group_type="Insurance"; }
  else { throw new Error("Unexpected loop in ADT demo: " + loop_id); }
  loop_instance_number=text(loop_instance); item_code=""; item_description=""; organization=""; item_sequence=-1;
}
if (row_type == "SEGMENT" &amp;&amp; (segment_id == "PR1" || segment_id == "IN1")) {
  item_sequence=Number(sequence_number);
}
if (row_type == "COMPOSITE" &amp;&amp; Number(parent_sequence_number)==item_sequence) {
  if (segment_id == "PR1" &amp;&amp; Number(element_position)==3 || segment_id == "IN1" &amp;&amp; Number(element_position)==2) {
    item_code=text(element_01); item_description=text(element_02);
  }
  if (segment_id == "IN1" &amp;&amp; Number(element_position)==4) { organization=text(element_01); }
}
// Emit after all segments and composites in this instance have arrived.
if (row_type == "LOOP_END") {
  if (!patient_id || !patient_name || !item_code) { throw new Error("Incomplete ADT demo fields; check the supplied sample and model."); }
  pipeline_Status=CONTINUE_PIPELINE;
}</jsScript_script>
      </jsScript>
      <jsScript>
        <jsScript_type>1</jsScript_type>
        <jsScript_name>Initialize admission context</jsScript_name>
        <jsScript_script>var patient_id="", patient_name="", group_type="", item_code="", item_description="", organization="";
var pid_sequence=-1, name_sequence=-1, item_sequence=-1;
var loop_instance_number="";</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>patient_id</name>
        <rename>patient_id</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>patient_name</name>
        <rename>patient_name</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>group_type</name>
        <rename>group_type</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>loop_instance_number</name>
        <rename>loop_instance_number</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>item_code</name>
        <rename>item_code</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>item_description</name>
        <rename>item_description</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>organization</name>
        <rename>organization</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
  </transform>
  <transform>
    <name>Write admission items</name>
    <type>TextFileOutput</type>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>680</xloc>
      <yloc>300</yloc>
    </GUI>
    <separator>,</separator>
    <enclosure>"</enclosure>
    <header>Y</header>
    <footer>N</footer>
    <format>UNIX</format>
    <encoding>UTF-8</encoding>
    <compression>None</compression>
    <create_parent_folder>Y</create_parent_folder>
    <file>
      <name>${HL7_QUICK_START_HOME}/output/admission-items</name>
      <extention>csv</extention>
      <append>N</append>
      <split>N</split>
      <haspartno>N</haspartno>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <do_not_open_new_file_init>N</do_not_open_new_file_init>
      <add_to_result_filenames>Y</add_to_result_filenames>
    </file>
    <fields>
      <field>
        <name>patient_id</name>
        <type>String</type>
        <format />
        <decimal>.</decimal>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>patient_name</name>
        <type>String</type>
        <format />
        <decimal>.</decimal>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>group_type</name>
        <type>String</type>
